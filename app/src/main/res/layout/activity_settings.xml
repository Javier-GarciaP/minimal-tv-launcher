<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_margin"
    android:paddingTop="@dimen/settings_margin_top"
    android:paddingEnd="@dimen/settings_margin"
    android:paddingBottom="@dimen/settings_margin">

    <TextView
        android:id="@+id/screen_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingBottom="@dimen/settings_title_gap"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/screen_title_text_size" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/option_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:scrollbars="none" />

</LinearLayout>
