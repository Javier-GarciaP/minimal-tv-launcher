<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/row_background"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/row_padding_horizontal"
    android:paddingTop="@dimen/row_padding_vertical"
    android:paddingEnd="@dimen/row_padding_horizontal"
    android:paddingBottom="@dimen/row_padding_vertical">

    <TextView
        android:id="@+id/option_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/option_text_size" />

    <TextView
        android:id="@+id/option_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/row_icon_gap"
        android:includeFontPadding="false"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/option_value_text_size" />

</LinearLayout>
