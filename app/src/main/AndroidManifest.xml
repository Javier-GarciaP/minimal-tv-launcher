<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal permission: lets the launcher set the mountain image as the system
         wallpaper so the home screen does not jump when switching apps. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Android 11+ filters what an app can see. A launcher has to declare the
         launcher intent to get the full list of installed apps. This is a visibility
         declaration, not a permission: no user prompt and no runtime cost. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MinimalTV">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale">
            <!-- The home filter has to match exactly the one the system records when the
                 user picks this launcher, otherwise the preference is ignored. LAUNCHER
                 lives in a separate filter for that reason.
                 The priority makes this launcher win over the stock Google TV launcher
                 and over the setup wizard recovery activity, which both register a home
                 activity with a higher priority. -->
            <intent-filter android:priority="9000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Lets the app be started from the app drawer of other launchers. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale" />

        <activity
            android:name=".FeaturedPickerActivity"
            android:exported="false"
            android:label="@string/featured_picker_title"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale" />
    </application>

</manifest>
